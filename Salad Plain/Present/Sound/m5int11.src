;	public		timer_a_dt
;	public		timer_b_dt


	ORG	0000H
        DI
	DI
;        IM	1
 	JR	START
;---------------------------
;	OPN BUSY CHECK
;
	 	ORG	08H

OPN_BSY_CHK:
		LD	A,(OPNSTATUS)
		BIT	7,A
		JR	NZ,OPN_BSY_CHK
		RET

 		ORG	10H

 		JP	OPNWR

		ORG	18H
 		JP	OPN_DIRECT_WR


		org	20h
	;-----------------------------
	;	GET addr TABLE ADDR (BGMTB,VIBRTB etc..)
	;	  in C= off set 
	
adr_get:
		ld	hl,adrtb_bnk_adr	; HL = ADDRTB addr
	;--------------------------------
	;	IN HL = table addr
	;	   C = table offset
	;       OUT HL = (HL+BC)
adr_get0:
		ld	b,0
		jp	adr_get1		;

		org	28h
	;-------------------------------
	; 	word table serch
	;	in A = serch no
	;	  HL = serch table addr
	; 	OUT HL = addr
GETTBL:
	 	LD	C,A			; A =VIBR or ENVE NO.
GETTBL10:
	 	LD	B,0			;
 		ADD	HL,BC
	 	ADD	HL,BC			; table point addr get
;		jp	GET_TB_ADDR
		nop
		nop
		nop
		org	30h

GET_TB_ADDR:
 		LD	A,(HL)
	 	INC	HL
 		LD	H,(HL)			; 
	 	LD	L,A			; HL=table addr
		RET

START1:
		ORG	38H
	;--------- < fm chip access wait >--------
STACHK:
;		push	af
;		push	bc
;		push	de
;		push	hl
;		ld	hl,INTCNT
