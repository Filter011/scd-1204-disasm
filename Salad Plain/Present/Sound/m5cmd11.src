;-----------------------;
;	EV		;	db	EV,< PSG ENV NO. >
;-----------------------;
JENV:
;	BIT	7,(IX+CHIAN)		; if bit 7= 0 then fm (ret)
;	RET	Z

;	LD	(IX+ENVE),A		; enve no. set
;	RET
;-----------------------;
;	VR		;	db	VR,< VIBR NO. >
;-----------------------;
JVIBR:
;JVIBR0:
;	LD	(IX+VIBR),A	; set vibrate no.
	RET

;	END
