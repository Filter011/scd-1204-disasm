;	public	gate	
;	public	gate_str
;	public	fvr_str	
;	public	fvr_frq	
;	public	fvr_dely
;	public	fvr_lcnt
;	public	fvr_add	
;	public	fvr_lmt	
;	public	panstr	
;        public	pan_no	
;        public	pan_tbno
;        public	pan_ct0	
;        public	pan_ct1	
;        public	pan_ct2	
;        public	pan_ct3	
